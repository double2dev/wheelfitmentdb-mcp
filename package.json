{
  "name": "wheelfitmentdb-mcp",
  "version": "1.0.0",
  "description": "MCP Server for automotive wheel fitment engineering calculators (offset, backspacing, PCD, hub rings) & OEM-verified vehicle lookup by WheelFitmentDB.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "wheelfitmentdb-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "data/sample_50.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "start": "node dist/index.js",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "wheel-fitment",
    "bolt-pattern",
    "pcd",
    "automotive",
    "offset-calculator",
    "hub-centric-rings",
    "wheelfitmentdb"
  ],
  "author": "WheelFitmentDB <hello@wheelfitmentdb.com>",
  "license": "MIT",
  "homepage": "https://wheelfitmentdb.com/mcp/",
  "repository": {
    "type": "git",
    "url": "https://github.com/double2dev/wheelfitmentdb-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/double2dev/wheelfitmentdb-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
